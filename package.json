{
  "name": "rlist",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=!rlist-extension",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=rlist-web",
    "build:extension": "turbo run build --filter=rlist-extension",
    "deploy:web": "pnpm --filter rlist-web run deploy",
    "dev:extension": "pnpm --filter rlist-extension run dev",
    "preview:web": "pnpm build:web && pnpm --filter rlist-web run preview",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "check": "biome check .",
    "typecheck": "turbo run typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": ["biome check --write --no-errors-on-unmatched"]
  },
  "packageManager": "pnpm@9.15.2",
  "pnpm": {
    "patchedDependencies": {
      "xcode@3.0.1": "patches/xcode@3.0.1.patch"
    }
  }
}
